{
  "name": "workers-forge",
  "description": "Convention-driven build, dev, and deploy tooling for Cloudflare Workers monorepos",
  "type": "module",
  "version": "1.0.4-beta.2",
  "license": "MIT",
  "author": "JhMaic",
  "homepage": "https://github.com/JhMaic/workers-forge#readme",
  "bugs": {
    "url": "https://github.com/JhMaic/workers-forge/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JhMaic/workers-forge.git"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "wrangler",
    "tool",
    "build",
    "deploy",
    "cli",
    "monorepo"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./tsconfig": "./tsconfig/worker.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "workers-forge": "./bin/workers-forge.mjs"
  },
  "files": [
    "dist",
    "bin",
    "tsconfig",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4",
    "@types/node": ">=20",
    "hono": "^4",
    "tsx": "^4",
    "typescript": "^6",
    "wrangler": "^4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "globby": "^14.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@types/node": "^25.5.2",
    "hono": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2",
    "wrangler": "^4"
  }
}
