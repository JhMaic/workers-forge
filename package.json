{
  "name": "workers-forge",
  "description": "Convention-driven build, dev, and deploy tooling for Cloudflare Workers monorepos",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JhMaic/workers-forge.git"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "wrangler",
    "build",
    "deploy",
    "cli",
    "monorepo"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build/index.ts",
    "./hono": "./src/hono.ts"
  },
  "main": "./src/index.ts",
  "bin": {
    "workers-forge": "./bin/workers-forge.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "hono": "^4",
    "tsx": "^4",
    "wrangler": "^4"
  },
  "dependencies": {
    "globby": "^14.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@types/node": "^25.5.2",
    "hono": "^4",
    "tsx": "^4",
    "vitest": "^4.1.2",
    "wrangler": "^4"
  }
}
