{
  "name": "@example/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:local":      "workers-forge gen src/app.meta.ts --out wrangler.jsonc --env local      --config ../../workers-forge.config.ts",
    "gen:staging":    "workers-forge gen src/app.meta.ts --out wrangler.jsonc --env staging    --config ../../workers-forge.config.ts",
    "gen:production": "workers-forge gen src/app.meta.ts --out wrangler.jsonc --env production --config ../../workers-forge.config.ts",
    "dev:local":      "pnpm gen:local && next dev",
    "dev:staging":    "pnpm gen:staging && next dev",
    "build":          "next build",
    "preview:local":     "pnpm gen:local      && opennextjs-cloudflare preview",
    "preview:staging":   "pnpm gen:staging    && opennextjs-cloudflare preview",
    "deploy:staging":    "pnpm gen:staging    && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:production": "pnpm gen:production && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "next": "^16.2.6",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@example/workers": "workspace:*",
    "@types/node": ">=20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^6",
    "workers-forge": "link:../../../..",
    "wrangler": "^4.90.0"
  }
}
