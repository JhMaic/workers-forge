# Runtime variable override (matches bindings.vars key)
APP_ENV=local

# Infrastructure IDs — injected into process.env at build time; not runtime vars.
# CF_CONFIG_D1_ID: any non-empty string works for local wrangler dev (uses local SQLite).
CF_CONFIG_D1_ID=00000000-0000-0000-0000-000000000001
# CF_CONFIG_D1_SUFFIX: appended to database_name to distinguish envs (e.g. "todos-local")
